<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Configurações do Banco de Dados (MySQL) -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/Bombeiro</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password"></property>

        <!-- Dialeto SQL para MySQL 8 -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>

        <!-- Exibe o SQL gerado no console e o formata -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>

        <!-- Cria/Atualiza as tabelas automaticamente no banco -->
        <property name="hibernate.hbm2ddl.auto">update</property>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.Bombeiros"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.Viatura"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.Patente"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.AutoEscada"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.AutoTanque"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.Epecialidade"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.StatusBombeiro"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.StatusViatura"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.TelefoneContato"/>
        <mapping clas = "ifc.ibrama.projetosalahibernate.pedro.entidades.UnidadeResgate"/>
    </session-factory>
</hibernate-configuration>